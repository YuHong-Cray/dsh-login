{
  "name": "dsh-login",
  "version": "0.1.0",
  "description": "Login gate for the DeepSeek Harness Web GUI — self-service register + login, backed by a built-in SQLite account store (or an optional MySQL table), plus per-user instance handoff",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "files": [
    "index.js",
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "verify": "node bin/verify.mjs",
    "test": "node --test test/"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "login",
    "registration",
    "authentication",
    "sqlite",
    "mysql",
    "web-ui"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
